<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RestaurantSimulator.ViewModels"
             x:Class="RestaurantSimulator.Views.StationsView"
             x:DataType="vm:StationsViewModel">

    <Border Background="#5C3A4B" BorderBrush="#9B7888" BorderThickness="0">
        <Grid Margin="10" RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0" Text="Stations" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,10"/>
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Visible"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Stations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:StationDisplayViewModel">
                            <Border Background="#6E4A5D" BorderBrush="#9B7888" BorderThickness="1" Margin="0,0,0,8" Padding="10" CornerRadius="3">
                                <StackPanel>
                                    <TextBlock Text="{Binding Type}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12"/>
                                    <TextBlock Text="{Binding DefaultCount, StringFormat='Capasity: {0}'}" Foreground="#F8F3F5" FontSize="11" Margin="0,2,0,0"/>
                                    <TextBlock Text="Contents:" Foreground="#F8F3F5" FontSize="11" Margin="0,6,0,2"/>
                                    <ItemsControl ItemsSource="{Binding MovedIngredients}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:StationIngredientViewModel">
                                                <TextBlock Foreground="#F8F3F5" FontSize="10" Margin="0,1,0,0">
                                                    <Run Text="- "/>
                                                    <Run Text="{Binding Name}"/>
                                                    <Run Text=": "/>
                                                    <Run Text="{Binding Amount}"/>
                                                    <Run Text=" "/>
                                                    <Run Text="{Binding Unit}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>

</UserControl>
