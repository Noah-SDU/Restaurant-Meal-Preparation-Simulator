<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RestaurantSimulator.ViewModels"
             xmlns:m="using:RestaurantSimulator.Models"
             x:Class="RestaurantSimulator.Views.RecipeView"
             x:DataType="vm:RecipeViewModel">

    <Border Background="#5C3A4B" BorderBrush="#9B7888" BorderThickness="0">
        <Grid Margin="10" RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0" Text="Recipes" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,10"/>
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Visible"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Recipes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="m:Recipes">
                            <Border Background="#6E4A5D" BorderBrush="#9B7888" BorderThickness="1" Margin="0,0,0,8" Padding="10" CornerRadius="3">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12"/>
                                    <TextBlock Text="{Binding Difficulty, StringFormat='Difficulty: {0}'}" Foreground="#F8F3F5" FontSize="11" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding SalePrice, StringFormat='Sale price: {0:C2}'}" Foreground="#F8F3F5" FontSize="11" Margin="0,2,0,0"/>

                                    <TextBlock Text="Ingredients:" Foreground="#F8F3F5" FontSize="11" Margin="0,6,0,2"/>
                                    <ItemsControl ItemsSource="{Binding RequiredIngredients}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Foreground="#F8F3F5" FontSize="10" Margin="0,1,0,0">
                                                    <Run Text="- "/>
                                                    <Run Text="{Binding Name}"/>
                                                    <Run Text=": "/>
                                                    <Run Text="{Binding Quantity}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="Steps:" Foreground="#F8F3F5" FontSize="11" Margin="0,6,0,2"/>
                                    <ItemsControl ItemsSource="{Binding Steps}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Foreground="#F8F3F5" FontSize="10" Margin="0,1,0,0" TextWrapping="Wrap">
                                                    <Run Text="- "/>
                                                    <Run Text="{Binding Step}"/>
                                                    <Run Text=" ("/>
                                                    <Run Text="{Binding StationType}"/>
                                                    <Run Text=", "/>
                                                    <Run Text="{Binding Duration}"/>
                                                    <Run Text=" min)"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>

</UserControl>
